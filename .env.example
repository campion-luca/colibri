# Frontend (pubbliche: finiscono nel bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_VAPID_PUBLIC_KEY=

# Solo per i test RLS (npm run test:rls / npm run rls:cleanup).
# Mai con prefisso VITE_, mai importata da codice in src/.
SUPABASE_SECRET_KEY=

# Edge Function (secrets Supabase, non nel frontend)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:...
